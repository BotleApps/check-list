{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "backend-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/auth/callback$",
      "target": "index.html",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}
